# Secrets. Never tracked, in any form.
.env
.env.*
!.env.example
config/.env
config/.env.*
!config/.env.example
secrets/
*.pem
*.key
*.p12
*.pfx

# The real, confidential suppression roster. The tracked template is
# config/suppress.txt; this overlay is the live customer list.
config/suppress.local.txt
prototype/config/suppress.local.txt

# Runtime and client state. queue.jsonl, campaigns.jsonl and everything that
# travels with them are real client data, not source.
work/
out/
prototype/work/
prototype/out/
prototype/batches/

# Provider response dumps and local scratch.
logs/
tmp/
cache/
scratchpad/
*.log
dumps/
*.dump

# Local backups.
*.bak
*.orig
*.rej
backup/
backups/

# Python.
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.coverage
coverage/
htmlcov/

# Node, if it ever appears.
node_modules/

# Editor / OS noise.
.DS_Store
Thumbs.db
.idea/
.vscode/

# The client's own prospect universe. "SAFE INPUT" in the pack's README means
# domains only - no names, addresses or profiles - but it is still a list of
# real companies somebody paid for, and 24,710 of them is the whole target
# market. The pilot subsets are nested inside it.
#
# Ignored rather than merely left untracked, so a `git add` that means to
# catch a report cannot catch these instead. That nearly happened on
# 2026-09-10.
batches/productive-*.csv
batches/*_SAFE_INPUT.zip
work/claims/
work/worktree-locks/

# Personal Claude Code permissions for this checkout. Not team config, and
# never a place for a credential.
.claude/settings.local.json
hosts/*.env
hosts/*.env.local

# Generated by scripts/server/generate_units.py during a deploy, INSIDE the
# checkout. Untracked and unignored, it made `git status --porcelain`
# non-empty, and deploy.sh's dirty-tree guard then refused the NEXT deploy -
# a deploy that blocks the one after it. Found on the host, 2026-09-24.
build/

# A committed suite verdict is never evidence. Operator, 2026-09-25.
# It was found mid-run holding a complete, plausible verdict from hours
# earlier, and `git status` showing it unmodified is what exposed it. The
# file is still written by scripts/run_suite.py and read by
# task123_diff_failures.py - it is just no longer carried in the history,
# where a stale one reads as current.
scripts/suite_verdict.txt
