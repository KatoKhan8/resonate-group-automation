# Copy to hosts/production.env (gitignored) and fill in.
# VALUES ONLY - no secrets in this file. Provider credentials live in
# /etc/resonate/secrets.env on the host, root-owned, and are never in git.
HOST_NAME=resonate-production
HOST_IPV4=
HOST_IPV6=
HOST_LOCATION=hel1
HOST_PLAN=
HOST_OS=ubuntu-26.04
SSH_USER=resonate
SSH_PORT=22
APP_DIR=/home/resonate/resonate-group-automation
SECRETS_FILE=/etc/resonate/secrets.env
BACKUP_TARGET=
PUBLIC_HOSTNAME=
