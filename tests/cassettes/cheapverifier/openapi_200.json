  "paths": {
   "/email-validation": {
    "get": {
     "tags": [
      "Single address"
     ],
     "summary": "Verify one address",
     "description": "Waits for the result and returns it. When the fleet is slower than the request can wait, returns `202` with a `fileId` to poll — that is a slow answer, not a failure.",
     "parameters": [
      {
       "name": "email",
       "in": "query",
       "required": true,
       "schema": {
        "type": "string",
        "format": "email"
       },
       "description": "The address to verify."
      },
      {
       "name": "catchAll",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "0",
         "1",
         "true",
         "false",
         "yes",
         "no"
        ]
       },
       "description": "Run the catch-all check. A catch-all result costs nothing."
      },
      {
       "name": "premium",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "0",
         "1",
         "true",
         "false",
         "yes",
         "no"
        ]
       },
       "description": "Request the premium path, where it is enabled."
      },
      {
       "name": "mode",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "quick",
         "advanced"
        ],
        "default": "quick"
       },
       "description": "`advanced` adds a second confirmation pass that can recover valid mailboxes an initial check rejected, and can take up to 10x longer. It falls back to `quick` when the platform-wide setting is off."
      }
     ],
     "responses": {
      "200": {
       "description": "The verdict.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/SingleValidationResponse"
         }
        }
       }
      },
      "202": {
       "description": "Still running. Poll `/email-validation/status/{fileId}`.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/PendingValidationResponse"
         }
        }
       }
      },
      "400": {
       "description": "The request is malformed, or the file cannot be read.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "401": {
       "description": "Missing or invalid API key.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "402": {
       "description": "The workspace cannot cover the request. Raised before any address is queued, so nothing was charged and no work started.",
       "content": {
        "application/json": {
         "schema": {
          "allOf": [
           {
            "$ref": "#/components/schemas/Error"
           },
           {
            "type": "object",
            "properties": {
             "code": {
              "type": "string",
              "enum": [
               "INSUFFICIENT_CREDITS"
              ]
             },
             "creditsRequired": {
              "type": "integer"
             },
             "creditsAvailable": {
              "type": "integer"
             }
            }
           }
          ]
         }
        }
       }
      },
      "500": {
       "description": "Unexpected error.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      }
     }
    }
   },
