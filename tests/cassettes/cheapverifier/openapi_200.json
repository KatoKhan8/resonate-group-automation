       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      }
     }
    }
   },
   "/file/upload": {
    "post": {
     "tags": [
      "Bulk"
     ],
     "summary": "Upload a list for bulk verification",
     "description": "Returns a `fileId` immediately. Poll it with `/task/status/{taskId}`, then read the verdicts from `/task/details/{fileId}`.\n\n**The file:** `.csv` or `.xlsx`, one address per row, up to 1 GB. Extra columns are ignored.\n\n**The extension decides whether a file is accepted; the `Content-Type` is ignored.** It has to be — `curl -F \"file=@list.csv\"` sends `application/octet-stream`, and every HTTP client guesses differently.\n\n**A header row is optional.** A file that is nothing but addresses, one per line, is valid — its first line is not mistaken for a header.\n\n**The address column is found for you**, in this order:\n\n1. `selectedFields` if you send one.\n2. A column named `email`, `emails`, `e-mail`, `email_address`, `work_email`, `mail`, `address` or `recipient`.\n3. No header — row 0 is already an address, so every row is data.\n4. Otherwise the column that actually holds addresses, scored across the rows.\n\nSo `selectedFields` is only needed to force an unusual column name.",
     "requestBody": {
      "required": true,
      "content": {
       "multipart/form-data": {
        "schema": {
         "type": "object",
         "required": [
          "file"
         ],
         "properties": {
          "file": {
           "type": "string",
           "format": "binary",
           "description": "The `.csv` or `.xlsx` file."
          },
          "catchAll": {
           "type": "string",
           "enum": [
            "true",
            "false"
           ],
           "description": "Run the catch-all check. Catch-all results cost nothing."
          },
          "mode": {
           "type": "string",
           "enum": [
            "quick",
            "advanced"
           ],
           "default": "quick",
           "description": "`advanced` adds a second confirmation pass that can recover valid mailboxes an initial check rejected, and can take up to 10x longer. It falls back to `quick` when the platform-wide setting is off."
          },
          "priority": {
           "type": "string",
           "enum": [
            "high",
            "normal",
            "low"
           ],
           "default": "normal"
          },
          "premium": {
           "type": "string",
           "enum": [
            "true",
            "false"
           ],
           "description": "Request the premium path, where it is enabled."
          },
          "selectedFields": {
           "type": "string",
           "description": "Optional column mapping as JSON, e.g. `{\"Email\":\"work_email\"}`. Omit it unless the address column has an unusual name."
          }
         }
        },
        "encoding": {
         "file": {
          "contentType": "text/csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/octet-stream"
         }
        }
       }
      }
     },
     "responses": {
      "200": {
       "description": "Accepted and queued.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/FileUploadResponse"
         }
        }
       }
      },
      "400": {
       "description": "The request is malformed, or the file cannot be read.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "401": {
       "description": "Missing or invalid API key.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "402": {
       "description": "The workspace cannot cover the request. Raised before any address is queued, so nothing was charged and no work started.",
       "content": {
        "application/json": {
         "schema": {
          "allOf": [
           {
            "$ref": "#/components/schemas/Error"
           },
           {
            "type": "object",
            "properties": {
             "code": {
              "type": "string",
              "enum": [
               "INSUFFICIENT_CREDITS"
              ]
             },
             "creditsRequired": {
              "type": "integer"
             },
             "creditsAvailable": {
              "type": "integer"
             }
            }
           }
          ]
         }
        }
       }
      },
      "500": {
       "description": "Unexpected error.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      }
     }
    }
   },
   "/task/status/{taskId}": {
    "get": {
     "tags": [
      "Bulk"
     ],
     "summary": "How far a file has got",
     "description": "`data.status` is `processing` until every row has a verdict, then `completed`.",
     "parameters": [
      {
       "name": "taskId",
       "in": "path",
       "required": true,
       "schema": {
        "type": "string"
       },
       "description": "The `fileId` from the upload."
      }
     ],
     "responses": {
      "200": {
       "description": "Current progress.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/TaskStatusResponse"
         }
        }
       }
      },
      "400": {
       "description": "The request is malformed, or the file cannot be read.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "401": {
       "description": "Missing or invalid API key.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "404": {
       "description": "No such file.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "500": {
       "description": "Unexpected error.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      }
     }
    }
   },
   "/task/details/{fileId}": {
    "get": {
     "tags": [
      "Bulk"
     ],
     "summary": "Read a file's verdicts",
     "description": "Every row carries the same verdict fields as the single-address endpoint — `outcome`, `reason_code`, `confidence`, `algorithm_version`, `validity` and `evidence`. Nothing is lost by verifying in bulk.\n\n10 rows per page; omit `page` to return every row.",
     "parameters": [
      {
       "name": "fileId",
       "in": "path",
       "required": true,
       "schema": {
        "type": "string"
       }
      },
      {
       "name": "page",
       "in": "query",
       "required": false,
       "schema": {
        "type": "integer",
        "minimum": 1
       },
       "description": "Omit for every row."
      },
      {
       "name": "domain",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string"
       },
       "description": "Only addresses at this domain."
      }
     ],
     "responses": {
      "200": {
       "description": "The verdicts.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/TaskDetailsResponse"
         }
        }
       }
      },
      "400": {
       "description": "The request is malformed, or the file cannot be read.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "401": {
       "description": "Missing or invalid API key.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "404": {
       "description": "No such file, or it has no results yet.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "500": {
       "description": "Unexpected error.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      }
     }
    }
   },
   "/verify/{email}": {
    "get": {
     "tags": [
      "Stored results"
     ],
     "summary": "Look up a stored verdict for one address",
     "description": "Reads a verdict already produced for this workspace, with its earlier verdicts in `history`. Verifies nothing and costs nothing.",
     "parameters": [
      {
       "name": "email",
       "in": "path",
       "required": true,
       "schema": {
        "type": "string",
        "format": "email"
       },
       "description": "URL-encoded."
      },
      {
       "name": "upload_id",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string"
       },
       "description": "Restrict to one file."
      }
     ],
     "responses": {
      "200": {
       "description": "The stored verdict.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/StoredResultResponse"
         }
        }
       }
      },
      "400": {
       "description": "The request is malformed, or the file cannot be read.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "401": {
       "description": "Missing or invalid API key.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
