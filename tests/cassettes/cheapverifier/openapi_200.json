   "/uploads/{upload_id}/results": {
    "get": {
     "tags": [
      "Stored results"
     ],
     "summary": "Page or export a file's stored results",
     "description": "A filterable, offset-paged view of one file, with `summary` counts across the whole file rather than the filtered page. `format=csv` streams a CSV instead of JSON.\n\nNote this endpoint has its own status vocabulary — it reports `risky` and `catch-all` where `/task/details` reports an `outcome`.",
     "parameters": [
      {
       "name": "upload_id",
       "in": "path",
       "required": true,
       "schema": {
        "type": "string"
       }
      },
      {
       "name": "status",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "valid",
         "invalid",
         "risky",
         "catch-all",
         "unknown"
        ]
       }
      },
      {
       "name": "failed_at",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "syntax",
         "mx_record",
         "platform_detection",
         "smtp_validation",
         "catch_all",
         "seg_detection"
        ]
       },
       "description": "Only rows that stopped at this stage."
      },
      {
       "name": "seg_gateway",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "barracuda",
         "proofpoint",
         "mimecast",
         "cisco",
         "symantec"
        ]
       }
      },
      {
       "name": "limit",
       "in": "query",
       "required": false,
       "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
       }
      },
      {
       "name": "offset",
       "in": "query",
       "required": false,
       "schema": {
        "type": "integer",
        "minimum": 0
       }
      },
      {
       "name": "format",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "json",
         "csv"
        ],
        "default": "json"
       }
      }
     ],
     "responses": {
      "200": {
       "description": "The results.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/UploadResultsResponse"
         }
        },
        "text/csv": {
         "schema": {
          "type": "string"
         },
         "example": "email,final_status,hard_bounce,failed_at,seg_gateway,validated_at\ninfo@gameson.co.uk,invalid,true,smtp_validation,,2026-09-16T06:14:13.000Z\n"
        }
       }
      },
      "400": {
       "description": "The request is malformed, or the file cannot be read.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "401": {
       "description": "Missing or invalid API key.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "404": {
       "description": "No such upload.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "422": {
       "description": "A query parameter is outside its allowed values.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      },
      "500": {
       "description": "Unexpected error.",
       "content": {
        "application/json": {
         "schema": {
          "$ref": "#/components/schemas/Error"
         }
        }
       }
      }
     }
    }
   },
