[
  {
    "call": "anthropic-check",
    "note": "Health check: minimal response confirming the key works.",
    "match": {"method": "POST", "url_contains": "/v1/messages", "body_contains": "ping"},
    "status": 200,
    "response": {
      "id": "msg-check-1",
      "type": "message",
      "role": "assistant",
      "model": "claude-sonnet-5",
      "content": [{"type": "text", "text": "ok"}],
      "stop_reason": "end_turn",
      "usage": {"input_tokens": 5, "output_tokens": 1}
    }
  },
  {
    "call": "anthropic-complete",
    "note": "A single message completion with full usage including cache tokens.",
    "match": {"method": "POST", "url_contains": "/v1/messages", "body_contains": "Write to:"},
    "status": 200,
    "response": {
      "id": "msg-anth-1",
      "type": "message",
      "role": "assistant",
      "model": "claude-sonnet-5",
      "content": [{"type": "text", "text": "{\"hold\": false, \"subject\": \"margin visibility at meridian\", \"steps\": {\"em1\": \"Hi Ivana, I saw Meridian is hiring senior consultants in Zagreb.\"}, \"confidence\": 0.85}"}],
      "stop_reason": "end_turn",
      "usage": {
        "input_tokens": 1200,
        "output_tokens": 350,
        "cache_creation_input_tokens": 800,
        "cache_read_input_tokens": 400
      }
    }
  },
  {
    "call": "anthropic-complete-no-cache",
    "note": "A completion without cache tokens - the minimum usage shape.",
    "match": {"method": "POST", "url_contains": "/v1/messages", "body_contains": "simple test"},
    "status": 200,
    "response": {
      "id": "msg-anth-2",
      "type": "message",
      "role": "assistant",
      "model": "claude-sonnet-5",
      "content": [{"type": "text", "text": "Hello! How can I help?"}],
      "stop_reason": "end_turn",
      "usage": {"input_tokens": 10, "output_tokens": 8}
    }
  },
  {
    "call": "anthropic-batch-results",
    "note": "Batch results as JSONL text. Two succeeded, one errored. MUST come before batch-get so the /results URL matches first.",
    "match": {"method": "GET", "url_contains": "/results"},
    "status": 200,
    "response": "{\"custom_id\": \"lead-1\", \"result\": {\"type\": \"succeeded\", \"message\": {\"id\": \"msg-r1\", \"type\": \"message\", \"role\": \"assistant\", \"model\": \"claude-sonnet-5\", \"content\": [{\"type\": \"text\", \"text\": \"{\\\"hold\\\": false, \\\"subject\\\": \\\"test subject 1\\\"}\"}], \"stop_reason\": \"end_turn\", \"usage\": {\"input_tokens\": 500, \"output_tokens\": 200}}}}\n{\"custom_id\": \"lead-2\", \"result\": {\"type\": \"succeeded\", \"message\": {\"id\": \"msg-r2\", \"type\": \"message\", \"role\": \"assistant\", \"model\": \"claude-sonnet-5\", \"content\": [{\"type\": \"text\", \"text\": \"{\\\"hold\\\": false, \\\"subject\\\": \\\"test subject 2\\\"}\"}], \"stop_reason\": \"end_turn\", \"usage\": {\"input_tokens\": 600, \"output_tokens\": 250}}}}\n{\"custom_id\": \"lead-3\", \"result\": {\"type\": \"errored\", \"error\": {\"type\": \"error\", \"error\": {\"type\": \"invalid_request_error\", \"message\": \"max_tokens exceeded\"}, \"request_id\": \"req-err-1\"}}}"
  },
